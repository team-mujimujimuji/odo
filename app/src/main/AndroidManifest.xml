<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Android Automotive OS 전용 앱 -->
    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.wifi"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.screen.portrait"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.screen.landscape"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!-- 차속(AAOS 표준). Pleos SDK에 차속 API가 없다. -->
    <uses-permission android:name="android.car.permission.CAR_SPEED" />
    <!-- Pleos Vehicle: 기어·주행거리(CAR_DRIVE), 안전벨트(CAR_SEATS), 방향지시등(CAR_LIGHTS), 와이퍼(CAR_WINDOWS) -->
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />
    <uses-permission android:name="pleos.car.permission.CAR_SEATS" />
    <uses-permission android:name="pleos.car.permission.CAR_LIGHTS" />
    <uses-permission android:name="pleos.car.permission.CAR_WINDOWS" />
    <!-- Pleos FusedLocation. 위치는 기기 밖으로 보내지 않는다. -->
    <uses-permission android:name="pleos.car.permission.FUSED_LOCATION" />

    <!-- Pleos TTS(1차는 읽기만, STT는 쓰지 않는다) -->
    <uses-permission android:name="pleos.car.permission.TTS_SERVICE" />

    <!-- Pleos TTS가 실패할 때 대신 읽을 안드로이드 TTS 엔진을 찾으려면 targetSdk 30 이상에서 이 조회 선언이 필요하다. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:name=".OdoApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Odo">

        <!--
            분할 창 크기 변경(screenSize·smallestScreenSize·screenLayout·orientation)과 시스템 주야 전환(uiMode)에는
            액티비티를 다시 만들지 않고 Compose가 제자리에서 다시 그린다. 다시 만들면 주행 중 글랜스의 지도·미니카가
            잠깐 비고 트립 요약 연출·효과음이 처음부터 다시 나온다. 화면은 Compose뿐이고, 테마는 하나(주야는 앱 시계로 정함)이며,
            res에 주야·크기 한정자가 없고, 크기는 레이아웃 제약에서 읽는다. 글꼴 배율·밀도·언어 변경은 리소스를 다시
            읽어야 해서 넣지 않는다(그때는 다시 만들어진다).
        -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|uiMode"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!--
                주행 중 사용 선언(Distraction Optimized). 이 선언이 없으면 Pleos Connect가 주행 중에
                앱을 "주행 중에는 사용할 수 없습니다" 화면으로 가려 글랜스 모드가 보이지 않는다.
                선언한 앱은 주행 제한을 스스로 지켜야 한다: 주행 중에는 글랜스 화면만 그리고
                DriveLockOverlay가 모든 터치를 막는다(CarUxDrivingRestriction으로 시스템 제한도 따른다).
            -->
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
        </activity>
    </application>

</manifest>
